# Configuración para la instalación con Docker Compose.
# Copiá este archivo a ".env" (en la raíz del proyecto) y completá los
# valores antes de correr "docker compose up -d --build".
# Guía completa: docs/INSTALL.md

# --- Dominio/URL pública ------------------------------------------------
# La URL donde vas a acceder al webmail desde el navegador (con https:// si
# ya tenés certificado, por ejemplo detrás de aaPanel/cPanel/Plesk como
# proxy reverso). Para probar en tu propia PC dejá localhost.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# Puertos publicados en el host (cambialos si ya los usás para otra cosa).
WEB_PORT=3000
API_PORT=3001

# --- Base de datos --------------------------------------------------------
MYSQL_ROOT_PASSWORD="change-me"
MYSQL_DATABASE="webmail"
MYSQL_USER="webmail"
MYSQL_PASSWORD="change-me"

# --- Seguridad -------------------------------------------------------------
# Generá valores propios, por ejemplo con: openssl rand -hex 32
JWT_SECRET="change-me-to-a-random-secret"
# Tiene que tener EXACTAMENTE 32 caracteres.
MAIL_ENCRYPTION_KEY="change-me-32-characters-exactly!"
