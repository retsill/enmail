# Copiá este archivo a ".env" y completá los valores.
# Ver docs/INSTALL.md para más detalle según tu tipo de instalación.

# --- Base de datos (MySQL) -------------------------------------------------
# Formato: mysql://usuario:password@host:puerto/nombre_base
# Si usás Docker Compose, dejá el valor de abajo tal cual (apunta al
# contenedor "db" del docker-compose.yml incluido).
DATABASE_URL="mysql://webmail:webmail@db:3306/webmail"

# --- Seguridad --------------------------------------------------------------
# Generá valores propios y secretos para producción, por ejemplo con:
#   openssl rand -hex 32
JWT_SECRET="change-me-to-a-random-secret"
JWT_EXPIRES_IN="86400"

# Debe tener EXACTAMENTE 32 caracteres — se usa para cifrar en reposo las
# contraseñas/tokens de las cuentas de correo guardadas.
MAIL_ENCRYPTION_KEY="change-me-32-characters-exactly!"

# --- URLs --------------------------------------------------------------------
# URL pública donde sirven el frontend (Next.js). Se usa para redirects de
# OAuth (conectar Gmail/Outlook) y CORS.
FRONTEND_URL="http://localhost:3000"

# Puerto en el que escucha la API (por defecto 3001).
PORT=3001
